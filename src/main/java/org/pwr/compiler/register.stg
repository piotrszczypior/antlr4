group pierwszy;

deflt(elem) ::= <<
    <elem; separator="\n">
>>

int(i) ::= <<
MOV A,#<i>
>>

variable(i) ::= <<
MOV A,[<i>]
>>

twoop(p1, p2) ::= <<
<p2>
PUSH A
<p1>
POP B
>>

declaration(name) ::= <<
DD <name>
>>

declarationWithAssignment(name, value) ::= <<
DD <name>
<value>
MOV [<name>],A
>>

assignment(name, value) ::= <<
<value>
MOV [<name>],A
>>

addition(p1,p2) ::= <<
<twoop(p1,p2)>
ADD A, B
>>

subtraction(p1, p2) ::= <<
<twoop(p1,p2)>
SUB A, B
>>

multiplication(p1, p2) ::= <<
<twoop(p1,p2)>
MUL A, B
>>

division(p1, p2) ::= <<
<twoop(p1,p2)>
DIV A, B
>>

comparisonEqual(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B

JNE label_comparison_<id>
MOV A,#1
JMP label_comparsion_end_<id>

label_comparison_<id>:
    MOV A,#0

label_comparsion_end_<id>:
>>

comparisonNotEqual(p1, p2) ::= <<
<twoop(p1,p2)>
CMP A,B
>>

if(condition, thenStatement, elseStatement, id) ::= <<
<condition>
    JE label_else_<id>
<thenStatement>
    JMP label_endif_<id>

label_else_<id>:
    <elseStatement>

label_endif_<id>:
>>
