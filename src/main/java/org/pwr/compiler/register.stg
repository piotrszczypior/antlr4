group pierwszy;

deflt(elem) ::= <<
    <elem; separator="\n">
>>

int(i) ::= <<
MOV A,#<i>
>>

variable(i) ::= <<
MOV A,[<i>]
>>

twoop(p1, p2) ::= <<
<p2>
PUSH A
<p1>
POP B
>>

parameter(p) ::= <<
<p>
PUSH A
>>

popParameter(p) ::= <<
POP B
>>

takeFromStack(p, i) ::= <<
<declaration(p)>
MOV A, [BP+<i>]
MOV [<p>], A
>>

declaration(name) ::= <<
DD <name>
>>

declarationWithAssignment(name, value) ::= <<
DD <name>
<value>
MOV [<name>],A
>>

assignment(name, value) ::= <<
<value>
MOV [<name>],A
>>

addition(p1,p2) ::= <<
<twoop(p1,p2)>
ADD A, B
>>

subtraction(p1, p2) ::= <<
<twoop(p1,p2)>
SUB A, B
>>

multiplication(p1, p2) ::= <<
<twoop(p1,p2)>
MUL A, B
>>

division(p1, p2) ::= <<
<twoop(p1,p2)>
DIV A, B
>>

comparisonEqual(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B

JNE label_comparison_<id>
MOV A,#1
JMP label_comparsion_end_<id>

label_comparison_<id>:
    MOV A,#0

label_comparsion_end_<id>:
>>

comparisonNotEqual(p1, p2) ::= <<
<twoop(p1,p2)>
CMP A,B
>>

andStatement(p1, p2, id) ::= <<
<twoop(p1,p2)>
PUSH B
MOV B,#0
CMP A,B
JE label_and_false_<id>
POP B
MOV A,#0
CMP B,A
JE label_and_false_<id>
MOV A,#1
JMP label_and_end_<id>


label_and_false_<id>:
    MOV A,#0

label_and_end_<id>:
>>

orStatement(p1, id) ::= <<
<twoop(p1,p2)>
PUSH B
MOV B,#1
CMP A,B
JE label_or_true_<id>
POP B
MOV A, #1
CMP B,A
JNE label_or_true_<id>
MOV A,#0
JMP label_or_end_<id>

label_or_true_<id>:
    MOV A,#1

label_or_end_<id>:
>>

notStatement(p1, id) ::= <<
<p1>
PUSH A
JZ label_return_true_<id>
MOV A,#0
JMP label_not_end_<id>

label_return_true_<id>:
    MOV A,#1

label_not_end_<id>:
>>

lessThan(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B
JNL label_logic_<id>
MOV A,#0
JMP label_logic_end_<id>

label_logic_<id>:
    MOV A,#1

label_logic_end_<id>:
>>

lessThanOrEqual(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B
JNLE label_logic_<id>
MOV A,#0

JMP label_logic_end_<id>

label_logic_<id>:
    MOV A,#1

label_logic_end_<id>:
>>

greaterThan(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B
JNG label_logic_<id>
MOV A,#1

JMP label_logic_end_<id>

label_logic_<id>:
    MOV A,#0

label_logic_end_<id>:
>>

greaterThanOrEqual(p1, p2, id) ::= <<
<twoop(p1,p2)>
CMP A,B
JNGE label_logic_<id>
MOV A,#1

JMP label_logic_end_<id>

label_logic_<id>:
    MOV A,#0

label_logic_end_<id>:
>>

if(condition, thenStatement, elseStatement, id) ::= <<
<condition>
    JE label_else_<id>
<thenStatement>
    JMP label_endif_<id>

label_else_<id>:
    <elseStatement>

label_endif_<id>:
>>

functionDefinition(name, parameters, body, numerOfParams) ::= <<
<name>:
    PUSH BP
    MOV BP, #<numerOfParams>
    <parameters:{p | <takeFromStack(p, i)>)>}; separator="\n">

    <body>
    MOV BP, SP

    POP BP
    RET
>>

functionCall(name, parameters, body) ::= <<
<parameters:parameter(); separator="\n">
CALL <name>
<parameters:popParameter();  separator="\n">
>>